# ==============================================================================
# BIẾN MÔI TRƯỜNG DÀNH CHO DOCKER COMPOSE + CLOUDFLARE TUNNEL
# Sao chép file này thành .env hoặc truyền trực tiếp vào Docker Compose
# ==============================================================================

# 1. Token xác thực Cloudflare Tunnel (Lấy từ Cloudflare Zero Trust Dashboard -> Networks -> Tunnels)
# Khuyên dùng: Token giúp tự động thiết lập và duy trì kết nối outbound an toàn mà không cần quản lý file cert
TUNNEL_TOKEN=eyJhIjoi...your_cloudflare_tunnel_token_here...

# 2. Thông tin đăng nhập bảo vệ trang Quản Trị (/admin) qua HTTP Basic Auth
# Nginx Proxy Guard sẽ tự động tạo hash bảo mật và áp dụng ngay khi khởi động
ADMIN_USER=admin
ADMIN_PASSWORD=ThayDoiMatKhauNayNgayLapTuc2026!

# 3. Cấu hình cổng cục bộ cho OBS Studio (Chỉ lắng nghe trên 127.0.0.1, an toàn tuyệt đối trước scan port bên ngoài)
LOCAL_GATEWAY_PORT=3000

# 4. Địa chỉ nội bộ của TTS Microservice (Trong Docker network nội bộ)
TTS_SERVICE_URL=http://tts-service:8008

# 5. Cấu hình TikTok Live & EulerStream Signing Key
# TIKTOK_USER: Tên kênh TikTok tự động kết nối khi khởi động (nếu đang phát Live)
# TIKTOK_USER=zenfacts_vn
# SIGN_API_KEY: EulerStream API key để tạo chữ ký WebSocket không giới hạn lượt gọi (đăng ký miễn phí tại https://www.eulerstream.com/pricing)
# SIGN_API_KEY=your_eulerstream_api_key_here
