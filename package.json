    "test": "bun test",
    "test:tts": "python -m pytest tests"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "three": "^0.169.0",
    "tiktok-live-connector": "^2.1.0",
    "ws": "^8.18.0"
  }
}
