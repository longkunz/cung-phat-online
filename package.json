{
  "name": "tiktok-live-temple-rpc",
  "version": "1.0.0",
  "description": "TikTok Live RPC Interactive Buddhist Temple (Bun.js + ZeroTTS giọng Mai Chi)",
  "main": "server.js",
  "scripts": {
    "start": "node scripts/run-all.js",
    "dev": "node scripts/run-all.js --dev",
    "start:gateway": "node server.js",
    "start:tts": "node scripts/run-tts.js",
    "dev:gateway": "node --watch server.js",
