{
  "name": "chua-thien-mu-live-rpc",
  "version": "1.0.0",
  "description": "Chùa Thiên Mụ — TikTok Live RPC Interactive Buddhist Sanctuary (Bun.js + ZeroTTS giọng Mai Chi)",
  "main": "server.js",
  "scripts": {
    "start": "bun run scripts/run-all.js",
    "dev": "bun run scripts/run-all.js --dev",
    "start:gateway": "bun run server.js",
    "start:tts": "bun run scripts/run-tts.js",
    "dev:gateway": "bun --watch server.js",
    "dev:tts": "bun run scripts/run-tts.js --dev",
    "test": "bun test",
    "test:tts": "python -m pytest tests"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "three": "^0.169.0",
    "tiktok-live-connector": "^2.1.0",
    "ws": "^8.18.0"
  }
}
